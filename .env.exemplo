# Copie para .env na raiz para usar Docker Compose.
# Gere valores novos com: python -c "import secrets; print(secrets.token_hex(32))"
# Use a senha do banco em hexadecimal para poder inseri-la na URL sem escapes.
POSTGRES_PASSWORD=
SECRET_KEY=
# Origens completas, sem barra final, separadas por vírgula.
CORS_ORIGINS=
ENDERECO_DO_APP=
